    <codeTemplate version="4.6.0">
      <id>8f67020b-20f9-3d52-839b-b9424ca1ebc7</id>
      <name>Filter out invalid FHIR messages</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>DESTINATION_DISPATCHER</contextType>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
          <contextType>SOURCE_RECEIVER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	A filter rule that only lets valid messages through. Set Invalid Messages to
	Accept, otherwise invalid messages are already rejected before the filter.
*/
if ($(&apos;fhirValid&apos;) == false) {
    logger.warn(&apos;Invalid FHIR message:\n&apos; + $(&apos;fhirIssues&apos;));
    return false;
}
return true;</code>
      </properties>
    </codeTemplate>
    <codeTemplate version="4.6.0">
      <id>3908eb15-c47d-3a27-8c0a-528063bd155a</id>
      <name>Read a FHIR value</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	FHIR XML keeps values in the value attribute: read them with @value and
	toString(). Assumes Strip Namespaces is on (the default), so the FHIR XML has no
	namespace.
*/
var family = msg.name[0].family.@value.toString();</code>
      </properties>
    </codeTemplate>
    <codeTemplate version="4.6.0">
      <id>06b507eb-1cb3-37e4-a76e-29920bad0acc</id>
      <name>Set a FHIR value</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	Sets the value attribute of an existing element. Assumes Strip Namespaces is on
	(the default), so the FHIR XML has no namespace.
*/
msg.gender.@value = &apos;female&apos;;</code>
      </properties>
    </codeTemplate>
    <codeTemplate version="4.6.0">
      <id>1b6c831d-d4da-31ee-97ac-eaddf09478bf</id>
      <name>Add a FHIR element</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	Adds an element with a value attribute. The place does not matter: the outbound
	message is written in the element order of the specification. Assumes Strip
	Namespaces is on (the default), so the FHIR XML has no namespace.
*/
msg.appendChild(&lt;birthDate value=&quot;1980-01-01&quot;/&gt;);</code>
      </properties>
    </codeTemplate>
    <codeTemplate version="4.6.0">
      <id>487d09a3-8430-3675-aa69-77ee35450556</id>
      <name>Iterate FHIR Bundle entries</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	Walks through the entries of a Bundle. Each entry.resource holds one resource
	element, e.g. &lt;Patient&gt;. Assumes Strip Namespaces is on (the default), so the
	FHIR XML has no namespace.
*/
for each (var entry in msg.entry) {
    var resource = entry.resource.children()[0];
    logger.info(resource.localName() + &apos;/&apos; + resource.id.@value);
}</code>
      </properties>
    </codeTemplate>
    <codeTemplate version="4.6.0">
      <id>cc6c7cd5-3ed8-307b-a922-d2e87365a407</id>
      <name>Find a FHIR coding by system</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	Picks the code of the coding with a given system from a CodeableConcept. Assumes
	Strip Namespaces is on (the default), so the FHIR XML has no namespace.
*/
var loinc = msg.code.coding.(system.@value == &apos;http://loinc.org&apos;).code.@value.toString();</code>
      </properties>
    </codeTemplate>
    <codeTemplate version="4.6.0">
      <id>8f41eacd-6268-305b-a3f8-f686908708ee</id>
      <name>Find a FHIR extension by URL</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	Selects an extension by its url attribute; read its value with e.g.
	extension.valueString.@value. Assumes Strip Namespaces is on (the default), so
	the FHIR XML has no namespace.
*/
var extension = msg.extension.(@url == &apos;http://example.org/fhir/StructureDefinition/my-extension&apos;);</code>
      </properties>
    </codeTemplate>
