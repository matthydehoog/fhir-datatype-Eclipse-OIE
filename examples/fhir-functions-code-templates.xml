    <codeTemplate version="4.6.0">
      <id>6d1f6715-dbc1-3b61-8633-dac56dae888f</id>
      <name>Validate FHIR resource</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>CHANNEL_ATTACHMENT</contextType>
          <contextType>CHANNEL_BATCH</contextType>
          <contextType>CHANNEL_DEPLOY</contextType>
          <contextType>CHANNEL_POSTPROCESSOR</contextType>
          <contextType>CHANNEL_PREPROCESSOR</contextType>
          <contextType>CHANNEL_UNDEPLOY</contextType>
          <contextType>DESTINATION_DISPATCHER</contextType>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>GLOBAL_DEPLOY</contextType>
          <contextType>GLOBAL_POSTPROCESSOR</contextType>
          <contextType>GLOBAL_PREPROCESSOR</contextType>
          <contextType>GLOBAL_UNDEPLOY</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
          <contextType>SOURCE_RECEIVER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	Validates a FHIR resource (JSON, or XML with or without the FHIR namespace)
	against the FHIR R4 specification and its meta.profile. isValid() is false on
	errors; summary() gives one line per error and warning.
*/
var FhirTools = Packages.com.mirth.connect.plugins.datatypes.fhir.FhirTools;
var result = FhirTools.validate(msg.toString());
if (!result.isValid()) {
    logger.warn(&apos;Invalid FHIR resource:\n&apos; + result.summary());
}</code>
      </properties>
    </codeTemplate>
    <codeTemplate version="4.6.0">
      <id>cae643d7-4748-30f7-a05c-6b18d445d634</id>
      <name>Validate FHIR resource against a profile</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>CHANNEL_ATTACHMENT</contextType>
          <contextType>CHANNEL_BATCH</contextType>
          <contextType>CHANNEL_DEPLOY</contextType>
          <contextType>CHANNEL_POSTPROCESSOR</contextType>
          <contextType>CHANNEL_PREPROCESSOR</contextType>
          <contextType>CHANNEL_UNDEPLOY</contextType>
          <contextType>DESTINATION_DISPATCHER</contextType>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>GLOBAL_DEPLOY</contextType>
          <contextType>GLOBAL_POSTPROCESSOR</contextType>
          <contextType>GLOBAL_PREPROCESSOR</contextType>
          <contextType>GLOBAL_UNDEPLOY</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
          <contextType>SOURCE_RECEIVER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	Validates a FHIR resource against a required profile (canonical URL). The third
	argument lists files and folders with your own profiles and NPM packages,
	separated by &apos;;&apos; (empty for none).
*/
var FhirTools = Packages.com.mirth.connect.plugins.datatypes.fhir.FhirTools;
var result = FhirTools.validate(msg.toString(), &apos;http://example.org/fhir/StructureDefinition/my-patient&apos;, &apos;C:/fhir/packages&apos;);
if (!result.isValid()) {
    logger.warn(&apos;Resource does not conform to the profile:\n&apos; + result.summary());
}</code>
      </properties>
    </codeTemplate>
    <codeTemplate version="4.6.0">
      <id>4708a1c3-6d39-3300-90dc-9d7a8570b2c8</id>
      <name>Read FHIR validation issues</name>
      <revision>1</revision>
      <lastModified>
        <time>1790812800000</time>
        <timezone>UTC</timezone>
      </lastModified>
      <contextSet>
        <delegate>
          <contextType>CHANNEL_ATTACHMENT</contextType>
          <contextType>CHANNEL_BATCH</contextType>
          <contextType>CHANNEL_DEPLOY</contextType>
          <contextType>CHANNEL_POSTPROCESSOR</contextType>
          <contextType>CHANNEL_PREPROCESSOR</contextType>
          <contextType>CHANNEL_UNDEPLOY</contextType>
          <contextType>DESTINATION_DISPATCHER</contextType>
          <contextType>DESTINATION_FILTER_TRANSFORMER</contextType>
          <contextType>DESTINATION_RESPONSE_TRANSFORMER</contextType>
          <contextType>GLOBAL_DEPLOY</contextType>
          <contextType>GLOBAL_POSTPROCESSOR</contextType>
          <contextType>GLOBAL_PREPROCESSOR</contextType>
          <contextType>GLOBAL_UNDEPLOY</contextType>
          <contextType>SOURCE_FILTER_TRANSFORMER</contextType>
          <contextType>SOURCE_RECEIVER</contextType>
        </delegate>
      </contextSet>
      <properties class="com.mirth.connect.model.codetemplates.BasicCodeTemplateProperties">
        <type>DRAG_AND_DROP_CODE</type>
        <code>/**
	Walks through the errors and warnings of a validation. Each issue has severity,
	location, line, column, message and messageId. getIssues() also includes
	information messages.
*/
var FhirTools = Packages.com.mirth.connect.plugins.datatypes.fhir.FhirTools;
var result = FhirTools.validate(msg.toString());
var issues = result.getProblems();
for (var i = 0; i &lt; issues.size(); i++) {
    var issue = issues.get(i);
    logger.info(issue.get(&apos;severity&apos;) + &apos; &apos; + issue.get(&apos;location&apos;) + &apos;: &apos; + issue.get(&apos;message&apos;));
}</code>
      </properties>
    </codeTemplate>
